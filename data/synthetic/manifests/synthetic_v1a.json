{
  "cases": [
    {
      "case_id": "kinetic_type_reveal",
      "template": "kinetic_type_reveal.jsx",
      "prompt": "Create a 6-second 1920x1080 After Effects intro with a dark background, kinetic headline text, a subtitle, and three animated accent bars.",
      "tags": [
        "synthetic-v1",
        "typography",
        "intro",
        "shape-layers",
        "keyframes"
      ],
      "must_contain": [
        "app.project.items.addComp",
        "layers.addText",
        "setValueAtTime",
        "ADBE Vector Shape - Rect"
      ],
      "must_not_contain": [
        "app.quit(",
        "system.callSystem",
        "fetch(",
        "XMLHttpRequest"
      ],
      "expected": {
        "comp_name": "AEFT Kinetic Type Reveal",
        "width": 1920,
        "height": 1080,
        "duration_seconds": 6,
        "frame_rate": 30,
        "min_layers": 5,
        "render_frame": 45
      }
    },
