{
  "cases": [
    {
      "case_id": "cinematic_trailer_pulse",
      "template": "cinematic_trailer_pulse.jsx",
      "prompt": "Create an 8-second cinematic After Effects trailer opener with letterbox bars, sequential title cards, light sweeps, and an impact flash.",
      "tags": [
        "synthetic-v2",
        "trailer",
        "opener",
        "cinematic",
        "typography",
        "keyframes"
      ],
      "must_contain": [
        "app.project.items.addComp",
        "layers.addText",
        "setValueAtTime",
        "ADBE Vector Shape - Rect"
      ],
      "must_not_contain": [
        "app.quit(",
        "system.callSystem",
        "fetch(",
        "XMLHttpRequest"
      ],
      "expected": {
        "comp_name": "AEFT Cinematic Trailer Pulse",
        "width": 1920,
        "height": 1080,
        "duration_seconds": 8,
        "frame_rate": 30,
        "min_layers": 12,
        "render_frame": 120
      }
    },
