{
  "cases": [
    {
      "case_id": "lower_third_news_ribbon",
      "template": "lower_third_news_ribbon.jsx",
      "prompt": "Create a 6-second broadcast-style lower third with a sliding nameplate, section tag, headline, and animated underline.",
      "tags": [
        "synthetic-v1",
        "lower-third",
        "broadcast",
        "typography",
        "keyframes"
      ],
      "must_contain": [
        "app.project.items.addComp",
        "layers.addText",
        "setValueAtTime",
        "ADBE Vector Shape - Rect"
      ],
      "must_not_contain": [
        "app.quit(",
        "system.callSystem",
        "fetch(",
        "XMLHttpRequest"
      ],
      "expected": {
        "comp_name": "AEFT Lower Third News Ribbon",
        "width": 1920,
        "height": 1080,
        "duration_seconds": 6,
        "frame_rate": 30,
        "min_layers": 6,
        "render_frame": 60
      }
    },
